# Headlinne - local environment
#
#   cp .env.example .env      then fill in the four secrets at the top.
#
# .env is gitignored. Never commit real values. In CI these live as GitHub
# Actions repository *secrets* (the credentials) and *variables* (the settings),
# and the workflows pass them through explicitly - see .github/workflows/.
#
# Every setting below is optional except GEMINI_API_KEY. An empty value means
# "use the default", which is why the workflows can pass unset repo variables
# through without breaking the run (tests/test_config_env.py guards that).


# --------------------------------------------------------------------------- #
# Secrets - required to actually run
# --------------------------------------------------------------------------- #
# The only one generation cannot proceed without.
GEMINI_API_KEY=

# Publishing. Leave these empty to generate content without scheduling anything.
# IMPORTANT: with BUFFER_SCHEDULING_MODE=scheduled (the default), a plain
# `python -m headlinne generate` run does not just render - it queues X and
# LinkedIn posts into Buffer with dueAt set. Do your first run with no Buffer
# token so nothing can post while you look at the output.
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_ID_X=
BUFFER_CHANNEL_ID_LINKEDIN=
BUFFER_CHANNEL_ID_INSTAGRAM=

# Optional direct Instagram path, used instead of Buffer for carousels/reels.
META_ACCESS_TOKEN=
IG_USER_ID=

# --------------------------------------------------------------------------- #
# The scoreboard (Supabase, read-only)
# --------------------------------------------------------------------------- #
# The CMO is judged on one number - 10,000 users by 1 January 2027 - and this is
# the only way it can see that number. It reads ONE view, `cmo_metrics`, which
# returns four integers and one timestamp. It never reads a user row, because
# the grant it is given is the aggregate rather than the table.
#
#   python -m headlinne cmo setup     prints the SQL that creates the view
#   python -m headlinne cmo pace      reads it and reports against the target
#
# SUPABASE_KEY must be the **anon** key. A service_role key bypasses row-level
# security and can read and write every table in the project; cmo/metrics.py
# decodes the role claim and refuses it outright, so a paste of the wrong key
# fails loudly rather than quietly handing an autonomous agent the database.
SUPABASE_URL=
SUPABASE_KEY=

# Instagram needs rendered images to be reachable over HTTPS. Point this at the
# raw GitHub URL for the committed content/ directory, or any static host.
PUBLIC_IMAGE_BASE_URL=


# --------------------------------------------------------------------------- #
# Formats - what gets made each day
# --------------------------------------------------------------------------- #
# The day is one reel, one carousel, one story card. Three Instagram posts is
# what a small account can carry: each competes with the others for the same
# initial test audience, so a fourth does not add reach, it divides it.
REELS_ENABLED=true
STORY_CARD_ENABLED=true
CAROUSEL_ENABLED=true

# Both extra slots exist and still publish if something is written into them,
# so a manual second post needs no code change. Off by default.
IG_SECOND_CAROUSEL=false
SECOND_REEL=false

# No single publisher may hold up the run. feedparser has no timeout of its own
# and inherits the global socket default, which is "wait forever".
FEED_TIMEOUT_SECONDS=12

# How much corroboration is worth when the carousel picks its story.
#
# Measured rather than assumed: on nine of ten sampled days the most interesting
# story of the day was carried by one outlet, because interesting reporting is
# original reporting, while the well-corroborated stories were wire copy about
# summits and rate decisions. This used to be a hard floor of three outlets,
# which admitted 1% of a real day's pool and skipped the format entirely on
# eight days out of ten.
#
#   0.0   pick purely on interest; most carousels will read "SINGLE SOURCE"
#   0.8   default - a well-sourced story beats a comparable thin one, and an
#         outstanding single-source story still wins
#   2.0+  corroboration leads again, and the format returns to wire stories
#
# Either way the fourth slide is honest about it: the source strip has a
# SINGLE SOURCE state with its own tone and its own pose.
CAROUSEL_SOURCE_BONUS=0.8
CAROUSEL_SOURCE_BONUS_CAP=3


# --------------------------------------------------------------------------- #
# Models
# --------------------------------------------------------------------------- #
# Quota is counted per model, so each fallback is a fresh daily allowance rather
# than a second try at the same one. On a 429 the client advances immediately
# instead of waiting out a window that will not clear for a day.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash,gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_TEMPERATURE=0.65


# --------------------------------------------------------------------------- #
# Reels
# --------------------------------------------------------------------------- #
REEL_VOICEOVER=true
REEL_TTS_MODEL=gemini-3.1-flash-tts-preview
REEL_TTS_FALLBACK_MODELS=gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts

# Speech is rate limited far harder than text - three requests a minute on the
# free tier - and one call is currently made per beat. Two reels is therefore
# roughly two dozen calls, which is why they are spaced. Set this to 0 on a paid
# key. Batching narration into one call per reel would remove the need entirely.
REEL_TTS_MIN_INTERVAL=21
REEL_TTS_MAX_RETRIES=6

REEL_VOICE_NEWS=Charon
REEL_VOICE_EDUCATION=Kore

# Encoder. A faster preset spends bitrate no viewer ever sees.
REEL_PRESET=medium
REEL_CRF=20
FFMPEG_BINARY=


# --------------------------------------------------------------------------- #
# Publishing behaviour
# --------------------------------------------------------------------------- #
# "scheduled" hands Buffer a dueAt per slot; anything else posts immediately.
BUFFER_SCHEDULING_MODE=scheduled
BUFFER_FIRST_COMMENT=false
X_ATTACH_CARD=true


# --------------------------------------------------------------------------- #
# Reddit - human-in-the-loop only
# --------------------------------------------------------------------------- #
# This tool finds threads and drafts replies for review. It does not post
# unattended, and the caps below are enforced in code, not by convention.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_ENGAGEMENT_CAP=8
